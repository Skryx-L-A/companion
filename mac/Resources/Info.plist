<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>companion</string>
	<key>CFBundleDisplayName</key>
	<string>companion</string>
	<key>CFBundleIdentifier</key>
	<string>de.skryx.companion.mac</string>
	<key>CFBundleExecutable</key>
	<string>companion-mac</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- No Dock icon and no application menu; the menu bar item is the way in. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright Skryx-L-A. PolyForm-Noncommercial-1.0.0</string>
	<!-- Shown in the system prompt on the first recording. Without this key macOS terminates
	     the app instead of asking. It says where the audio goes, because that is the part a
	     person is deciding about. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Der Companion nimmt auf, solange du sprichst, und schickt den Ton an die Spracherkennung, die du in den Einstellungen verbunden hast.</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
</plist>
