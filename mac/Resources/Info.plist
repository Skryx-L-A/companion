<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>companion</string>
	<key>CFBundleDisplayName</key>
	<string>companion</string>
	<key>CFBundleIdentifier</key>
	<string>de.skryx.companion.mac</string>
	<key>CFBundleExecutable</key>
	<string>companion-mac</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- No Dock icon and no application menu; the menu bar item is the way in. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright Skryx-L-A. PolyForm-Noncommercial-1.0.0</string>
	<!-- Shown in the system prompt on the first recording. Without this key macOS terminates
	     the app instead of asking. It says where the audio goes, because that is the part a
	     person is deciding about. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Der Companion nimmt auf, solange du sprichst, und schickt den Ton an die Spracherkennung, die du in den Einstellungen verbunden hast.</string>
	<!-- Shown on the first calendar_list/create/update/delete. Without this key macOS
	     terminates the app instead of asking. It says what the calendar access is for. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Der Companion liest deinen Kalender und legt Termine an, ändert oder löscht sie, wenn du ihn danach fragst oder ausdrücklich darum bittest.</string>
	<!-- Shown on the first reminders_list/create/complete/delete. macOS asks for the
	     reminders separately from the calendar, so this is its own key, and without it the
	     system terminates the app instead of asking. -->
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Der Companion liest deine Erinnerungen und legt welche an, hakt sie ab oder löscht sie, wenn du ihn danach fragst oder ausdrücklich darum bittest.</string>
	<!-- Shown on the first weather/places lookup that falls back to the machine's own
	     position because no place is configured. Without this key macOS terminates the app
	     instead of asking. It says what the position is used for. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Der Companion fragt deinen Standort ab, um Wetter und Orte in deiner Nähe zu beantworten, wenn in den Einstellungen kein Ort eingetragen ist.</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
</plist>
