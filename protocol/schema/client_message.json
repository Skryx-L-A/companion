          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "Provenance5": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "ReadWindow": {
      "description": "Which slice of a session's output to read.",
      "oneOf": [
        {
          "description": "The last `lines` lines.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tail"
            },
            "lines": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "lines"
          ]
        },
        {
          "description": "Everything from a byte offset a previous read returned.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "from_offset"
            },
            "offset": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "offset"
          ]
        }
      ]
    },
    "RequestEnvelope": {
      "description": "A request with the id its response will carry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "description": "All sessions the daemon currently knows.",
          "type": "object",
          "properties": {
            "request": {
              "type": "string",
              "const": "list"
            }
          },
          "required": [
            "request"
          ]
        },
        {
          "type": "object",
          "properties": {
            "request": {
              "type": "string",
              "const": "spawn"
            }
          },
          "$ref": "#/$defs/SpawnRequest",
          "required": [
            "request"
          ]
        },
        {
          "type": "object",
          "properties": {
            "request": {
              "type": "string",
              "const": "send"
            },
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "request",
            "session_id",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "request": {
              "type": "string",
              "const": "read"
            },
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "window": {
              "$ref": "#/$defs/ReadWindow"
            }
          },
          "required": [
            "request",
            "session_id",
            "window"
          ]
        },
        {
          "type": "object",
          "properties": {
            "request": {
              "type": "string",
              "const": "stop"
            },
            "session_id": {
              "$ref": "#/$defs/SessionId"
            }
          },
          "required": [
            "request",
            "session_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "adapter": {
              "description": "A single adapter, or all of them when absent.",
              "anyOf": [
                {
                  "$ref": "#/$defs/AdapterId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "request": {
              "type": "string",
              "const": "capabilities"
            }
          },
          "required": [
            "request"
          ]
        },
        {
          "description": "Run one gate command of an approved job file, named by its position in the list.",
          "type": "object",
          "properties": {
            "gate_index": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "request": {
              "type": "string",
              "const": "run_gate"
            },
            "session_id": {
              "$ref": "#/$defs/SessionId"
            }
          },
          "required": [
            "request",
            "session_id",
            "gate_index"
          ]
        },
        {
          "description": "An orchestrator writes the status of its own session.",
          "type": "object",
          "properties": {
            "request": {
              "type": "string",
              "const": "report_status"
            },
            "status": {
              "description": "Boxed to keep the size of every other request down.",
              "$ref": "#/$defs/SessionStatus"
            }
          },
          "required": [
            "request",
            "status"
          ]
        },
        {
          "description": "An orchestrator asks the person something through the companion.",
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "question_id": {
              "type": "string"
            },
            "request": {
              "type": "string",
              "const": "ask_question"
            },
            "session_id": {
              "$ref": "#/$defs/SessionId"
            }
          },
          "required": [
            "request",
            "session_id",
            "question_id",
            "question"
          ]
        },
        {
          "description": "An orchestrator reports progress or a finished result.",
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "request": {
              "type": "string",
              "const": "report"
            },
            "result_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "session_id": {
              "$ref": "#/$defs/SessionId"
            }
          },
          "required": [
            "request",
            "session_id",
            "message"
          ]
        }
      ],
      "required": [
        "id"
      ]
    },
    "SessionId": {
      "description": "Identifies one session. Unique per machine, assigned by the adapter that owns the session.",
      "type": "string"
    },
    "SessionState": {
      "description": "What a session is doing right now.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "busy",
            "idle",
            "done",
            "error"
          ]
        },
        {
          "description": "Waiting for input from the person, including an open question.",
          "type": "string",
          "const": "waiting"
        }
      ]
    },
    "SessionStatus": {
      "description": "The status of one session.\n\n`DESIGN.md` § Datenmodelle lists this as: id, adapter, maschine, projekt, modell,\nzustand, laufzeit, kontext, budget, iteration, letzte_ausgabe, offene_frage,\nauftrag_id. Every field an adapter may not know carries its origin instead of a\nsilently plausible zero.",
      "type": "object",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterId"
        },
        "auftrag_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuftragId"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget": {
          "$ref": "#/$defs/Provenance4"
        },
        "context": {
          "$ref": "#/$defs/Provenance3"
        },
        "id": {
          "$ref": "#/$defs/SessionId"
        },
        "iteration": {
          "$ref": "#/$defs/Provenance5"
        },
        "last_output": {
          "description": "Last output of the session, trimmed to what the shell shows without asking.",
          "type": [
            "string",
            "null"
          ]
        },
        "machine": {
          "description": "Machine the session runs on. `local` for this machine.",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/Provenance"
        },
        "open_question": {
          "description": "The question the session is currently blocked on, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "description": "Absolute path of the project directory the session works in.",
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_ms": {
          "description": "Milliseconds since the session started.",
          "$ref": "#/$defs/Provenance2"
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        }
      },
      "required": [
        "id",
        "adapter",
        "machine",
        "model",
        "state",
        "runtime_ms",
        "context",
        "budget",
        "iteration"
      ]
    },
    "SpawnRequest": {
      "description": "What to start.",
      "type": "object",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterId"
        },
        "auftrag_id": {
          "description": "Job file to hand to the session. The daemon passes the path, never the text.",
          "anyOf": [
            {
              "$ref": "#/$defs/AuftragId"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "description": "Absolute path of the project directory.",
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "project"
      ]
    }
  }
}
