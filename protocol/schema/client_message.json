{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientMessage",
  "description": "Anything a client sends to the daemon. One JSON object per line.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        }
      },
      "$ref": "#/$defs/Hello",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "request"
        }
      },
      "$ref": "#/$defs/RequestEnvelope",
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "AdapterId": {
      "description": "Identifies a session adapter, for example `workbench` or `claude-code`.",
      "type": "string"
    },
    "AuftragId": {
      "description": "Identifies a job file under `.companion/auftraege/<id>.json`.",
      "type": "string"
    },
    "BudgetUsage": {
      "description": "How much of a subscription or spending budget a session has used up.",
      "type": "object",
      "properties": {
        "resets_at_ms": {
          "description": "Unix time in milliseconds at which the window resets, when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "used_fraction": {
          "description": "Share of the current window in use, between 0.0 and 1.0.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "used_fraction"
      ]
    },
    "ContextUsage": {
      "description": "How much of the model context window a session has used up.",
      "type": "object",
      "properties": {
        "used_fraction": {
          "description": "Share of the window in use, between 0.0 and 1.0.",
          "type": "number",
          "format": "double"
        },
        "used_tokens": {
          "description": "Tokens in the window, if the adapter knows the absolute number.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "used_fraction"
      ]
    },
    "Hello": {
      "description": "First message of every connection.\n\nThe client presents a token and nothing else; the daemon decides the role from it. A\nclient cannot claim to be human.",
      "type": "object",
      "properties": {
        "client_name": {
          "description": "Free-text name of the client, for the connection list and the log.",
          "type": "string"
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "token",
        "client_name"
      ]
    },
    "Provenance": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "Provenance2": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "Provenance3": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "$ref": "#/$defs/ContextUsage"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "$ref": "#/$defs/ContextUsage"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "Provenance4": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
