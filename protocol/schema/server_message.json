{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerMessage",
  "description": "Anything the daemon sends to a client. One JSON object per line.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        }
      },
      "$ref": "#/$defs/Welcome",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "response"
        }
      },
      "$ref": "#/$defs/Response",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "event"
        }
      },
      "$ref": "#/$defs/EventEnvelope",
      "required": [
        "type"
      ]
    },
    {
      "description": "This connection read its events too slowly and lost some. Only this client is\naffected, so the gap is reported to it alone instead of on the event stream.\nThe client should re-read the session list rather than trust what it has.",
      "type": "object",
      "properties": {
        "missed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "after_sequence": {
          "description": "The last sequence number that did arrive before the gap.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "events_dropped"
        }
      },
      "required": [
        "type",
        "missed",
        "after_sequence"
      ]
    },
    {
      "description": "The daemon refused the handshake and closes the connection right after.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "rejected"
        }
      },
      "$ref": "#/$defs/ProtocolError",
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "ClientRole": {
      "description": "What a connected client is allowed to do.\n\nThe role is never claimed by the client; the daemon derives it from the token that the\nclient presents during the handshake (`DESIGN.md` § Sicherheit).",
      "oneOf": [
        {
          "description": "The shell in front of the person. Every command is available.",
          "type": "string",
          "const": "human"
        },
        {
          "description": "An orchestrator docking onto the daemon. It may report, ask and write its own\nstatus; spawn, send, stop and gate execution are refused.",
          "type": "string",
          "const": "agent"
        }
      ]
    },
    "Welcome": {
      "description": "The daemon's answer to a valid [`Hello`].",
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "role": {
          "$ref": "#/$defs/ClientRole"
        },
        "daemon_version": {
          "description": "Version of the daemon binary.",
          "type": "string"
        },
        "run_id": {
          "description": "Identifies this run of the daemon. Sequence numbers restart at zero after a\nrestart, so a client compares this before it compares sequence numbers.",
          "type": "string"
        },
        "session_namespace": {
          "description": "The prefix the daemon puts in front of every session id this connection reports\nabout. A client may report, ask and report progress only inside it; the daemon\nassigns it, so no connection can write the status of another one's session.",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "role",
        "daemon_version",
        "run_id",
        "session_namespace"
      ]
    },
    "ResponseBody": {
      "description": "The payload of a successful response.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "sessions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SessionStatus"
              }
            },
            "body": {
              "type": "string",
              "const": "sessions"
            }
          },
          "required": [
            "body",
            "sessions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "session": {
              "description": "Boxed to keep the size of every other response down.",
              "$ref": "#/$defs/SessionStatus"
            },
            "body": {
              "type": "string",
              "const": "session"
            }
          },
          "required": [
            "body",
            "session"
          ]
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "next_offset": {
              "description": "Offset to pass to the next `read` to continue where this one stopped.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "body": {
              "type": "string",
              "const": "chunk"
            }
          },
          "required": [
            "body",
            "text",
            "next_offset"
          ]
        },
        {
          "type": "object",
          "properties": {
            "adapters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AdapterCapabilities"
              }
            },
            "body": {
              "type": "string",
              "const": "capabilities"
            }
          },
          "required": [
            "body",
            "adapters"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "$ref": "#/$defs/SendOutcome"
            },
            "body": {
              "type": "string",
              "const": "sent"
            }
          },
          "required": [
            "body",
            "outcome"
          ]
        },
        {
          "description": "The request was carried out and has nothing to return.",
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "const": "ack"
            }
          },
          "required": [
            "body"
          ]
        }
      ]
    },
    "SessionStatus": {
      "description": "The status of one session.\n\n`DESIGN.md` § Datenmodelle lists this as: id, adapter, maschine, projekt, modell,\nzustand, laufzeit, kontext, budget, iteration, letzte_ausgabe, offene_frage,\nauftrag_id. Every field an adapter may not know carries its origin instead of a\nsilently plausible zero.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/SessionId"
        },
        "adapter": {
          "$ref": "#/$defs/AdapterId"
        },
        "machine": {
          "description": "Machine the session runs on. `local` for this machine.",
          "type": "string"
        },
        "project": {
          "description": "Absolute path of the project directory the session works in.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "$ref": "#/$defs/Provenance"
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        },
        "runtime_ms": {
          "description": "Milliseconds since the session started.",
          "$ref": "#/$defs/Provenance2"
        },
        "context": {
          "$ref": "#/$defs/Provenance3"
        },
        "budget": {
          "$ref": "#/$defs/Provenance4"
        },
        "iteration": {
          "$ref": "#/$defs/Provenance5"
        },
        "last_output": {
          "description": "Last output of the session, trimmed to what the shell shows without asking.",
          "type": [
            "string",
            "null"
          ]
        },
        "open_question": {
          "description": "The question the session is currently blocked on, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "auftrag_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuftragId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "adapter",
        "machine",
        "model",
        "state",
        "runtime_ms",
        "context",
        "budget",
        "iteration"
      ]
    },
    "SessionId": {
      "description": "Identifies one session. Unique per machine, assigned by the adapter that owns the session.",
      "type": "string"
    },
    "AdapterId": {
      "description": "Identifies a session adapter, for example `workbench` or `claude-code`.",
      "type": "string"
    },
    "Provenance": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "SessionState": {
      "description": "What a session is doing right now.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "busy",
            "idle",
            "done",
            "error"
          ]
        },
        {
          "description": "Waiting for input from the person, including an open question.",
          "type": "string",
          "const": "waiting"
        }
      ]
    },
    "Provenance2": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "Provenance3": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "$ref": "#/$defs/ContextUsage"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "$ref": "#/$defs/ContextUsage"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "ContextUsage": {
      "description": "How much of the model context window a session has used up.",
      "type": "object",
      "properties": {
        "used_fraction": {
          "description": "Share of the window in use, between 0.0 and 1.0.",
          "type": "number",
          "format": "double"
        },
        "used_tokens": {
          "description": "Tokens in the window, if the adapter knows the absolute number.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "used_fraction"
      ]
    },
    "Provenance4": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "$ref": "#/$defs/BudgetUsage"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "$ref": "#/$defs/BudgetUsage"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "BudgetUsage": {
      "description": "How much of a subscription or spending budget a session has used up.",
      "type": "object",
      "properties": {
        "used_fraction": {
          "description": "Share of the current window in use, between 0.0 and 1.0.",
          "type": "number",
          "format": "double"
        },
        "resets_at_ms": {
          "description": "Unix time in milliseconds at which the window resets, when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "used_fraction"
      ]
    },
    "Provenance5": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "AuftragId": {
      "description": "Identifies a job file under `.companion/auftraege/<id>.json`.",
      "type": "string"
    },
    "AdapterCapabilities": {
      "description": "What one adapter can do. `DESIGN.md` § Sicherheit requires this to be honest about\nenforcement as well: a generic PTY adapter cannot restrict a foreign CLI, and the\nsettings page shows what a limit really means for that session.",
      "type": "object",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterId"
        },
        "display_name": {
          "description": "Human-readable name for the settings page.",
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandKind"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventKind"
          }
        },
        "status_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StatusField"
          }
        },
        "enforces_permission_modes": {
          "description": "True when the adapter can hand a permission mode down into the session and have it\nhold. False for anything that only drives a terminal.",
          "type": "boolean"
        },
        "supports_subagents": {
          "description": "True when sessions of this adapter can run sub-agents, which is what a gauntlet\nloop needs.",
          "type": "boolean"
        }
      },
      "required": [
        "adapter",
        "display_name",
        "commands",
        "events",
        "status_fields",
        "enforces_permission_modes",
        "supports_subagents"
      ]
    },
    "CommandKind": {
      "description": "The commands an adapter can carry out.",
      "type": "string",
      "enum": [
        "list",
        "spawn",
        "send",
        "read",
        "stop"
      ]
    },
    "EventKind": {
      "description": "The name of an event without its payload. Adapters use this in their capabilities to\nsay which events they can actually produce.",
      "type": "string",
      "enum": [
        "session_started",
        "session_ended",
        "question_open",
        "waiting_for_input",
        "busy",
        "idle",
        "done",
        "gate_result",
        "context_level",
        "budget_level",
        "iteration",
        "error",
        "events_dropped"
      ]
    },
    "StatusField": {
      "description": "The optional fields of a session status. An adapter names the ones it can fill; every\nfield it leaves out stays `unknown` in the session list.",
      "type": "string",
      "enum": [
        "project",
        "model",
        "runtime_ms",
        "context",
        "budget",
        "iteration",
        "last_output",
        "open_question",
        "auftrag_id"
      ]
    },
    "SendOutcome": {
      "description": "What happened to a `send`.",
      "oneOf": [
        {
          "description": "The session took the text right away.",
          "type": "string",
          "const": "delivered"
        },
        {
          "description": "A turn was still running, so the text is queued behind it.",
          "type": "string",
          "const": "queued"
        }
      ]
    },
    "ProtocolError": {
      "description": "An error with a message that is safe to show.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "ErrorCode": {
      "description": "Why a request failed.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "unknown_session",
            "unknown_adapter",
            "internal"
          ]
        },
        {
          "description": "Client and daemon disagree about [`crate::PROTOCOL_VERSION`].",
          "type": "string",
          "const": "unsupported_protocol_version"
        },
        {
          "description": "The token was not recognised.",
          "type": "string",
          "const": "unauthorized"
        },
        {
          "description": "The token was recognised, but the role may not do this.",
          "type": "string",
          "const": "forbidden"
        },
        {
          "description": "The adapter does not implement this command.",
          "type": "string",
          "const": "not_supported"
        },
        {
          "description": "The adapter tried and failed.",
          "type": "string",
          "const": "adapter_failure"
        },
        {
          "description": "The message did not parse, or a field was out of range.",
          "type": "string",
          "const": "bad_request"
        }
      ]
    },
    "Response": {
      "description": "A response, matched to its request by `id`.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "id"
      ],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ok"
            },
            "payload": {
              "$ref": "#/$defs/ResponseBody"
            }
          },
          "required": [
            "status",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "error"
            },
            "payload": {
              "$ref": "#/$defs/ProtocolError"
            }
          },
          "required": [
            "status",
            "payload"
          ]
        }
      ]
    },
    "Event": {
      "description": "Everything an adapter can report about a session.\n\nThe variant list is the event list from `DESIGN.md` § Session-Adapter, in that order.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "description": "Boxed because a status is by far the largest payload here, and every other\nevent would otherwise carry its size around.",
              "$ref": "#/$defs/SessionStatus"
            },
            "event": {
              "type": "string",
              "const": "session_started"
            }
          },
          "required": [
            "event",
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/EndReason"
            },
            "result_path": {
              "description": "Path of the result file the session left behind, when it wrote one.",
              "type": [
                "string",
                "null"
              ]
            },
            "event": {
              "type": "string",
              "const": "session_ended"
            }
          },
          "required": [
            "event",
            "reason"
          ]
        },
        {
          "description": "The session asked something and is blocked on the answer.",
          "type": "object",
          "properties": {
            "question_id": {
              "description": "Identifies the question so an answer can be routed back to it.",
              "type": "string"
            },
            "question": {
              "type": "string"
            },
            "event": {
              "type": "string",
              "const": "question_open"
            }
          },
          "required": [
            "event",
            "question_id",
            "question"
          ]
        },
        {
          "description": "The session waits for input without having asked a question, for example at a\npermission prompt.",
          "type": "object",
          "properties": {
            "hint": {
