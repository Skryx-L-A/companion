            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "AuftragId": {
      "description": "Identifies a job file under `.companion/auftraege/<id>.json`.",
      "type": "string"
    },
    "AdapterCapabilities": {
      "description": "What one adapter can do. `DESIGN.md` § Sicherheit requires this to be honest about\nenforcement as well: a generic PTY adapter cannot restrict a foreign CLI, and the\nsettings page shows what a limit really means for that session.",
      "type": "object",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterId"
        },
        "display_name": {
          "description": "Human-readable name for the settings page.",
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandKind"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventKind"
          }
        },
        "status_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StatusField"
          }
        },
        "enforces_permission_modes": {
          "description": "True when the adapter can hand a permission mode down into the session and have it\nhold. False for anything that only drives a terminal.",
          "type": "boolean"
        },
        "supports_subagents": {
          "description": "True when sessions of this adapter can run sub-agents, which is what a gauntlet\nloop needs.",
          "type": "boolean"
        }
      },
      "required": [
        "adapter",
        "display_name",
        "commands",
        "events",
        "status_fields",
        "enforces_permission_modes",
        "supports_subagents"
      ]
    },
    "CommandKind": {
      "description": "The commands an adapter can carry out.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "list",
            "spawn",
            "send",
            "read",
            "stop"
          ]
        },
        {
          "description": "Cut the running turn short without ending the session. `DESIGN.md`\n§ Session-Adapter keeps this apart from `send`, which queues behind the turn, and\nfrom `stop`, which ends the session.",
          "type": "string",
          "const": "interrupt"
        }
      ]
    },
    "EventKind": {
      "description": "The name of an event without its payload. Adapters use this in their capabilities to\nsay which events they can actually produce.",
      "type": "string",
      "enum": [
        "session_started",
        "session_ended",
        "question_open",
        "waiting_for_input",
        "busy",
        "idle",
        "done",
        "gate_result",
        "context_level",
        "budget_level",
        "iteration",
        "error",
        "events_dropped"
      ]
    },
    "StatusField": {
      "description": "The optional fields of a session status. An adapter names the ones it can fill; every\nfield it leaves out stays `unknown` in the session list.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "project",
            "model",
            "runtime_ms",
            "context",
            "budget",
            "iteration",
            "last_output",
            "open_question",
            "auftrag_id"
          ]
        },
        {
          "description": "Whether the adapter can say what a session is doing at all. An adapter that leaves\nthis out reports `unknown` and `lost` instead of guessing between busy and idle.",
          "type": "string",
          "const": "state"
        }
      ]
    },
    "SendOutcome": {
      "description": "What happened to a `send`.",
      "oneOf": [
        {
          "description": "The session took the text right away.",
          "type": "string",
          "const": "delivered"
        },
        {
          "description": "A turn was still running, so the text is queued behind it.",
          "type": "string",
          "const": "queued"
        }
      ]
    },
    "Auftrag": {
      "description": "The job file, stored in the project under `.companion/auftraege/<id>.json`.\n\n`DESIGN.md` § Datenmodelle lists this as: id, projekt, ziel, fertig_kriterium,\nreferenz, guardrails, gate_befehle, limits, loop_typ, modell, freigabe.",
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "$ref": "#/$defs/AuftragId"
        },
        "project": {
          "description": "Absolute path of the project directory.",
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "done_criterion": {
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "gate_commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GateCommand"
          },
          "default": []
        },
        "limits": {
          "$ref": "#/$defs/Limits",
          "default": {
            "iterations": null,
            "tokens": null,
            "time_seconds": null
          }
        },
        "loop_type": {
          "$ref": "#/$defs/LoopType"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval": {
          "description": "Absent until the person has approved the exact text. An unapproved job never\ncauses an outward action.",
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "project",
        "goal",
        "done_criterion",
        "loop_type"
      ]
    },
    "Reference": {
      "description": "The reference a critic judges the result against.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "path"
            }
          },
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        }
      ]
    },
    "GateCommand": {
      "description": "One gate command, split into program and arguments.\n\n`DESIGN.md` § Sicherheit requires the daemon to run the approved text and nothing else,\nwithout shell evaluation of variables or substitutions. Storing the command already\nsplit is what makes that structural: there is no string for a shell to expand.",
      "type": "object",
      "properties": {
        "program": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "working_dir": {
          "description": "Working directory for the command. Relative paths are resolved against the project.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "program"
      ]
    },
    "Limits": {
      "description": "Where a run has to stop even if it is not finished.",
      "type": "object",
      "properties": {
        "iterations": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "time_seconds": {
          "description": "Wall-clock limit. `DESIGN.md` § Loops names this the stand-in wherever the adapter\nreports neither iterations nor tokens.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "LoopType": {
      "description": "Which loop discipline the orchestrator runs.",
      "oneOf": [
        {
          "description": "One pass, the default.",
          "type": "string",
          "const": "once"
        },
        {
          "description": "Repeat until the done criterion holds or a limit is hit.",
          "type": "string",
          "const": "loop"
        },
        {
          "description": "Builder and critic per part, against a reference.",
          "type": "string",
          "const": "gauntlet"
        }
      ]
    },
    "Approval": {
      "description": "The person's approval of one exact job text.",
      "type": "object",
      "properties": {
        "approved_at_ms": {
          "description": "Unix time in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "text_sha256": {
          "description": "Hex-encoded SHA-256 of the approved job text, so a later edit invalidates it.",
          "type": "string"
        }
      },
      "required": [
        "approved_at_ms",
        "text_sha256"
      ]
    },
    "ProtocolError": {
      "description": "An error with a message that is safe to show.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "ErrorCode": {
      "description": "Why a request failed.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "unknown_session",
            "unknown_adapter",
            "internal"
          ]
        },
        {
          "description": "Client and daemon disagree about [`crate::PROTOCOL_VERSION`].",
          "type": "string",
          "const": "unsupported_protocol_version"
        },
        {
          "description": "The token was not recognised.",
          "type": "string",
          "const": "unauthorized"
        },
        {
          "description": "The token was recognised, but the role may not do this.",
          "type": "string",
          "const": "forbidden"
        },
        {
          "description": "The adapter does not implement this command.",
          "type": "string",
          "const": "not_supported"
        },
        {
          "description": "The adapter tried and failed.",
          "type": "string",
          "const": "adapter_failure"
        },
        {
          "description": "The message did not parse, or a field was out of range.",
          "type": "string",
          "const": "bad_request"
        }
      ]
    },
    "Response": {
      "description": "A response, matched to its request by `id`.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "id"
      ],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ok"
            },
            "payload": {
              "$ref": "#/$defs/ResponseBody"
            }
          },
          "required": [
            "status",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "error"
            },
            "payload": {
              "$ref": "#/$defs/ProtocolError"
            }
          },
          "required": [
            "status",
            "payload"
          ]
        }
      ]
    },
    "Event": {
      "description": "Everything an adapter can report about a session.\n\nThe variant list is the event list from `DESIGN.md` § Session-Adapter, in that order.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "description": "Boxed because a status is by far the largest payload here, and every other\nevent would otherwise carry its size around.",
              "$ref": "#/$defs/SessionStatus"
            },
            "event": {
              "type": "string",
              "const": "session_started"
            }
          },
          "required": [
            "event",
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/EndReason"
            },
            "result_path": {
              "description": "Path of the result file the session left behind, when it wrote one.",
              "type": [
                "string",
                "null"
              ]
            },
            "event": {
              "type": "string",
              "const": "session_ended"
            }
          },
          "required": [
            "event",
            "reason"
          ]
        },
        {
          "description": "The session asked something and is blocked on the answer.",
          "type": "object",
          "properties": {
            "question_id": {
              "description": "Identifies the question so an answer can be routed back to it.",
              "type": "string"
            },
            "question": {
              "type": "string"
            },
            "event": {
              "type": "string",
              "const": "question_open"
            }
          },
          "required": [
            "event",
            "question_id",
            "question"
          ]
        },
        {
          "description": "The session waits for input without having asked a question, for example at a\npermission prompt.",
          "type": "object",
          "properties": {
            "hint": {
              "type": [
                "string",
                "null"
              ]
            },
            "event": {
              "type": "string",
              "const": "waiting_for_input"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "busy"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "idle"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "description": "The session reports its work as finished. `session_ended` may or may not follow.",
          "type": "object",
          "properties": {
            "summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "result_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "event": {
              "type": "string",
              "const": "done"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "description": "A gate command from the job file ran and either passed or failed.",
          "type": "object",
          "properties": {
            "command": {
              "description": "The gate command as it was approved, quoted for display next to the verdict.",
              "type": "string"
            },
            "program": {
              "description": "The same command in the form that actually ran: no shell, no string to\nmisread. A reader that wants to know what happened looks here, not at the\ndisplay line.",
              "type": [
                "string",
                "null"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exit_code": {
              "description": "Exit code of the process. Absent when a signal ended it or it timed out.",
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            },
            "passed": {
              "type": "boolean"
            },
            "output": {
              "description": "Output of the gate, trimmed.",
              "type": [
                "string",
                "null"
              ]
            },
            "event": {
              "type": "string",
              "const": "gate_result"
            }
          },
          "required": [
            "event",
            "command",
            "passed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "context": {
              "$ref": "#/$defs/Provenance3"
            },
            "event": {
              "type": "string",
              "const": "context_level"
            }
          },
          "required": [
            "event",
            "context"
          ]
        },
        {
          "type": "object",
          "properties": {
            "budget": {
              "$ref": "#/$defs/Provenance4"
            },
            "event": {
              "type": "string",
              "const": "budget_level"
            }
          },
          "required": [
            "event",
            "budget"
          ]
        },
        {
          "type": "object",
          "properties": {
            "iteration": {
              "$ref": "#/$defs/Provenance5"
            },
            "event": {
              "type": "string",
              "const": "iteration"
            }
          },
          "required": [
            "event",
            "iteration"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "event": {
              "type": "string",
              "const": "error"
            }
          },
          "required": [
            "event",
            "message"
          ]
        },
        {
          "description": "Events were lost between an adapter and the bus before they could be numbered, so\nno gap in the sequence shows them. Only the daemon produces this; an adapter never\ndoes. It carries no session id because the loss can span several sessions.",
          "type": "object",
          "properties": {
            "missed": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "event": {
              "type": "string",
              "const": "events_dropped"
            }
          },
          "required": [
            "event",
            "missed"
          ]
        }
      ]
    },
    "EndReason": {
      "description": "Why a session ended.",
      "oneOf": [
        {
          "description": "The session finished its work.",
          "type": "string",
          "const": "finished"
        },
        {
          "description": "The person stopped it.",
          "type": "string",
          "const": "stopped"
        },
        {
          "description": "The session died without finishing.",
          "type": "string",
          "const": "crashed"
        },
        {
          "description": "The adapter no longer sees the session and cannot say why it went away.",
          "type": "string",
          "const": "lost"
        }
      ]
    },
    "EventEnvelope": {
      "description": "An event as it leaves the daemon: the adapter's report plus the bookkeeping the bus\nadds.\n\n`sequence` is strictly increasing within one daemon run and starts again at zero after\na restart, so `run_id` has to be compared first: a smaller sequence under a different\nrun id is a new daemon, not a reordering.",
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "run_id": {
          "description": "Identifies the daemon run that numbered this event, the same value the handshake\nreturned in [`crate::Welcome`].",
          "type": "string"
        },
        "timestamp_ms": {
          "description": "Unix time in milliseconds when the daemon published the event.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "adapter": {
          "$ref": "#/$defs/AdapterId"
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "event": {
          "$ref": "#/$defs/Event"
        }
      },
      "required": [
        "sequence",
        "run_id",
        "timestamp_ms",
        "adapter",
        "event"
      ]
    }
  }
}
