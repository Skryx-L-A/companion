{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerMessage",
  "description": "Anything the daemon sends to a client. One JSON object per line.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        }
      },
      "$ref": "#/$defs/Welcome",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "response"
        }
      },
      "$ref": "#/$defs/Response",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "event"
        }
      },
      "$ref": "#/$defs/EventEnvelope",
      "required": [
        "type"
      ]
    },
    {
      "description": "This connection read its events too slowly and lost some. Only this client is\naffected, so the gap is reported to it alone instead of on the event stream.\nThe client should re-read the session list rather than trust what it has.",
      "type": "object",
      "properties": {
        "missed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "after_sequence": {
          "description": "The last sequence number that did arrive before the gap.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "events_dropped"
        }
      },
      "required": [
        "type",
        "missed",
        "after_sequence"
      ]
    },
    {
      "description": "The daemon refused the handshake and closes the connection right after.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "rejected"
        }
      },
      "$ref": "#/$defs/ProtocolError",
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "ClientRole": {
      "description": "What a connected client is allowed to do.\n\nThe role is never claimed by the client; the daemon derives it from the token that the\nclient presents during the handshake (`DESIGN.md` § Sicherheit).",
      "oneOf": [
        {
          "description": "The shell in front of the person. Every command is available.",
          "type": "string",
          "const": "human"
        },
        {
          "description": "An orchestrator docking onto the daemon. It may report, ask and write its own\nstatus; spawn, send, stop and gate execution are refused.",
          "type": "string",
          "const": "agent"
        }
      ]
    },
    "Welcome": {
      "description": "The daemon's answer to a valid [`Hello`].",
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "role": {
          "$ref": "#/$defs/ClientRole"
        },
        "daemon_version": {
          "description": "Version of the daemon binary.",
          "type": "string"
        },
        "run_id": {
          "description": "Identifies this run of the daemon. Sequence numbers restart at zero after a\nrestart, so a client compares this before it compares sequence numbers.",
          "type": "string"
        },
        "session_namespace": {
          "description": "The prefix the daemon puts in front of every session id this connection reports\nabout. A client may report, ask and report progress only inside it; the daemon\nassigns it, so no connection can write the status of another one's session.",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "role",
        "daemon_version",
        "run_id",
        "session_namespace"
      ]
    },
    "ResponseBody": {
      "description": "The payload of a successful response.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "sessions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SessionStatus"
              }
            },
            "body": {
              "type": "string",
              "const": "sessions"
            }
          },
          "required": [
            "body",
            "sessions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "session": {
              "description": "Boxed to keep the size of every other response down.",
              "$ref": "#/$defs/SessionStatus"
            },
            "body": {
              "type": "string",
              "const": "session"
            }
          },
          "required": [
            "body",
            "session"
          ]
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "next_offset": {
              "description": "Offset to pass to the next `read` to continue where this one stopped.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "body": {
              "type": "string",
              "const": "chunk"
            }
          },
          "required": [
            "body",
            "text",
            "next_offset"
          ]
        },
        {
          "type": "object",
          "properties": {
            "adapters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AdapterCapabilities"
              }
            },
            "body": {
              "type": "string",
              "const": "capabilities"
            }
          },
          "required": [
            "body",
            "adapters"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "$ref": "#/$defs/SendOutcome"
            },
            "body": {
              "type": "string",
              "const": "sent"
            }
          },
          "required": [
            "body",
            "outcome"
          ]
        },
        {
          "description": "A job file together with the two things a person needs to approve it: the exact\ntext they are shown, and the hash of the canonical form of it.",
          "type": "object",
          "properties": {
            "auftrag": {
              "$ref": "#/$defs/Auftrag"
            },
            "hash": {
              "description": "Hex-encoded SHA-256 of the canonical form, without the approval field.",
              "type": "string"
            },
            "path": {
              "description": "Where the file lives.",
              "type": "string"
            },
            "gate_display": {
              "description": "The gate commands as they will be shown for approval, quoted.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "body": {
              "type": "string",
              "const": "auftrag"
            }
          },
          "required": [
            "body",
            "auftrag",
            "hash",
            "path",
            "gate_display"
          ]
        },
        {
          "description": "The request was carried out and has nothing to return.",
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "const": "ack"
            }
          },
          "required": [
            "body"
          ]
        }
      ]
    },
    "SessionStatus": {
      "description": "The status of one session.\n\n`DESIGN.md` § Datenmodelle lists this as: id, adapter, maschine, projekt, modell,\nzustand, laufzeit, kontext, budget, iteration, letzte_ausgabe, offene_frage,\nauftrag_id. Every field an adapter may not know carries its origin instead of a\nsilently plausible zero.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/SessionId"
        },
        "adapter": {
          "$ref": "#/$defs/AdapterId"
        },
        "machine": {
          "description": "Machine the session runs on. `local` for this machine.",
          "type": "string"
        },
        "project": {
          "description": "Absolute path of the project directory the session works in.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "$ref": "#/$defs/Provenance"
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        },
        "runtime_ms": {
          "description": "Milliseconds since the session started.",
          "$ref": "#/$defs/Provenance2"
        },
        "context": {
          "$ref": "#/$defs/Provenance3"
        },
        "budget": {
          "$ref": "#/$defs/Provenance4"
        },
        "iteration": {
          "$ref": "#/$defs/Provenance5"
        },
        "last_output": {
          "description": "Last output of the session, trimmed to what the shell shows without asking.",
          "type": [
            "string",
            "null"
          ]
        },
        "open_question": {
          "description": "The question the session is currently blocked on, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "auftrag_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuftragId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "adapter",
        "machine",
        "model",
        "state",
        "runtime_ms",
        "context",
        "budget",
        "iteration"
      ]
    },
    "SessionId": {
      "description": "Identifies one session. Unique per machine, assigned by the adapter that owns the session.",
      "type": "string"
    },
    "AdapterId": {
      "description": "Identifies a session adapter, for example `workbench` or `claude-code`.",
      "type": "string"
    },
    "Provenance": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "SessionState": {
      "description": "What a session is doing right now.\n\n`DESIGN.md` § Session-Adapter wants unknown things shown as unknown rather than as\nsomething plausible, and this field is where an adapter is most tempted to guess. An\nadapter that only sees a live terminal knows the session exists, not what it is doing:\nthat is [`SessionState::Unknown`]. One whose session has simply vanished knows it is\nover but not how it went: that is [`SessionState::Lost`].",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "busy",
            "idle",
            "error"
          ]
        },
        {
          "description": "Waiting for input from the person, including an open question.",
          "type": "string",
          "const": "waiting"
        },
        {
          "description": "Finished its work. Only for an adapter that saw it finish.",
          "type": "string",
          "const": "done"
        },
        {
          "description": "The session is there, but the adapter cannot tell what it is doing.",
          "type": "string",
          "const": "unknown"
        },
        {
          "description": "The session is gone and the adapter never learned how it ended. Over, but not\nfinished: a crash and a clean end look the same from the outside.",
          "type": "string",
          "const": "lost"
        }
      ]
    },
    "Provenance2": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "Provenance3": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "$ref": "#/$defs/ContextUsage"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "$ref": "#/$defs/ContextUsage"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "ContextUsage": {
      "description": "How much of the model context window a session has used up.",
      "type": "object",
      "properties": {
        "used_fraction": {
          "description": "Share of the window in use, between 0.0 and 1.0.",
          "type": "number",
          "format": "double"
        },
        "used_tokens": {
          "description": "Tokens in the window, if the adapter knows the absolute number.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "used_fraction"
      ]
    },
    "Provenance4": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "$ref": "#/$defs/BudgetUsage"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "$ref": "#/$defs/BudgetUsage"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "BudgetUsage": {
      "description": "How much of a subscription or spending budget a session has used up.",
      "type": "object",
      "properties": {
        "used_fraction": {
          "description": "Share of the current window in use, between 0.0 and 1.0.",
          "type": "number",
          "format": "double"
        },
        "resets_at_ms": {
          "description": "Unix time in milliseconds at which the window resets, when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "used_fraction"
      ]
    },
    "Provenance5": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
