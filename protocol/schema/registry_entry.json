{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegistryEntry",
  "description": "One line of the register: what ran, when, and what it left behind.\n\n`DESIGN.md` § Datenmodelle lists this as: session_id, auftrag_id, projekt, start, ende,\nergebnis, offene_punkte, selbstantworten, kosten.",
  "type": "object",
  "properties": {
    "auftrag_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuftragId"
        },
        {
          "type": "null"
        }
      ]
    },
    "cost": {
      "description": "Unknown wherever the adapter cannot report spend, rather than a plausible zero.",
      "$ref": "#/$defs/Provenance"
    },
    "ended_at_ms": {
      "description": "Unix time in milliseconds, absent while the session still runs.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "open_points": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_path": {
      "description": "Path of the result file the session wrote.",
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "self_answers": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SelfAnswer"
      }
    },
    "session_id": {
      "$ref": "#/$defs/SessionId"
    },
    "started_at_ms": {
      "description": "Unix time in milliseconds.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "started_at_ms",
    "cost"
  ],
  "$defs": {
    "AuftragId": {
      "description": "Identifies a job file under `.companion/auftraege/<id>.json`.",
      "type": "string"
    },
    "Cost": {
      "description": "What a run cost.",
      "type": "object",
      "properties": {
        "tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "Provenance": {
      "description": "A value together with where it came from.\n\n`DESIGN.md` § Session-Adapter requires every status field to carry its origin, and the\nsession list to show an unknown field as unknown rather than as empty or zero. Making\n`Unknown` a variant without a payload is what enforces that: there is no value to\nmistake for a measurement.",
      "oneOf": [
        {
          "description": "Read from a structured channel: a hook, a status file, an adapter report.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "measured"
            },
            "value": {
              "$ref": "#/$defs/Cost"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "Derived or guessed, for example a token count extrapolated from elapsed time.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "estimated"
            },
            "value": {
              "$ref": "#/$defs/Cost"
            }
          },
          "required": [
            "origin",
            "value"
          ]
        },
        {
          "description": "The adapter cannot supply this field at all.",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "origin"
          ]
        }
      ]
    },
    "SelfAnswer": {
      "description": "A question the companion answered on its own instead of waking the person, kept so the\nanswer can be reviewed afterwards.",
      "type": "object",
      "properties": {
        "answer": {
          "type": "string"
        },
        "answered_at_ms": {
          "description": "Unix time in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "question": {
          "type": "string"
        },
        "source": {
          "description": "Where the answer came from: the job file, a guardrail, the project profile.",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer",
        "source",
        "answered_at_ms"
      ]
    },
    "SessionId": {
      "description": "Identifies one session. Unique per machine, assigned by the adapter that owns the session.",
      "type": "string"
    }
  }
}
